  - m_Id: 7289502515187720
    m_Localized: Kecanduan Lampu Hijau
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187721
    m_Localized: 'Efek: Baterai berkurang lebih lambat.'
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187722
    m_Localized: 'Efek: Mengurangi penalti akibat tabrakan.'
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187723
    m_Localized: 'Efek: Meningkatkan bonus hadiah untuk setiap mobil yang lewat.'
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187724
    m_Localized: "\u201CLihat mobil lewat mulus itu rasanya... anehnya puas banget.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187725
    m_Localized: "\u201CTabrakan tadi... pura-pura aja bukan salahku.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187726
    m_Localized: "\u201CMungkin kalau aku nggak kebanyakan mikir, aku bisa tahan
      lebih lama.\u201D"
    m_Metadata:
      m_Items: []
