    m_Localized: Green Wave Addiction
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187721
    m_Localized: 'Effect: Battery drains slower.'
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187722
    m_Localized: 'Effect: Reduced punishment from collisions.'
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187723
    m_Localized: 'Effect: More bonus reward for each car passed.'
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187724
    m_Localized: "\u201CWatching cars pass smoothly feels... weirdly satisfying.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187725
    m_Localized: "\u201CThat collision.. Let\u2019s pretend it wasn\u2019t my fault.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 7289502515187726
    m_Localized: "\u201CMaybe if I think less, I last longer.\u201D"
    m_Metadata:
      m_Items: []
